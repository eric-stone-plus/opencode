#!/bin/sh
# Lint the working-tree content of staged JS/TS files. Whole-file staging is the
# norm here; a partially staged file is linted as it exists on disk. oxlint
# exits non-zero on errors (the gate); warnings are not blocked.
files=$(git diff --cached --name-only --diff-filter=ACMR -- '*.ts' '*.tsx' '*.js' '*.jsx' '*.mjs' '*.cjs')
if [ -z "$files" ]; then
  exit 0
fi
if [ ! -x node_modules/.bin/oxlint ]; then
  echo "pre-commit: node_modules/.bin/oxlint not found; run bun install (lint skipped)" >&2
  exit 0
fi
printf '%s\n' "$files" | tr '\n' '\0' | xargs -0 node_modules/.bin/oxlint --quiet --
