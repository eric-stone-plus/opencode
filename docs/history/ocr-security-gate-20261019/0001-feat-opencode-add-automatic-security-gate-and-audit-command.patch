+
+// ---------------------------------------------------------------------------
+// Automatic security gate (marginal-benefit bounded)
+//
+// OCR owns this policy; the OpenCode plugin is only the trigger + transport.
+// It never runs on a timer and never re-reviews an unchanged diff:
+//   L0 10-line checklist (code-audit skill)                     free
+//   L1 ocr review, low for small/non-sensitive diffs, medium
+//      for >200 changed lines or auth/crypto/input/secret paths  <=40k tok/run
+//   L2 manual `ocr scan --path` for a critical sensitive finding  <=1/session
+//   L3 one repro only when a test harness exists                  <=1/session
+//   L4 human / external                                           not automated
+// Stop rules: 3 runs, 120k total tokens, 2 empty runs, 2 injections, same
+// diff hash, or 2 OCR errors. The gate converges; it does not spin.
+// ---------------------------------------------------------------------------
+
+const GATE_ENABLED =
+  process.env.OPENCODE_SECURITY_GATE !== "0" && process.env.OCR_SECURITY_GATE !== "0"
+const GATE_DEBOUNCE_MS = 2_500
+const GATE_MIN_INTERVAL_MS = 15_000
+const GATE_MAX_RUNS = 3
+const GATE_MAX_TOTAL_TOKENS = 120_000
+const GATE_MAX_TOKENS_PER_RUN = 40_000
+const GATE_TIMEOUT_MS = 120_000
+const GATE_MAX_INJECTIONS = 2
+const GATE_INJECTION_COOLDOWN_MS = 60_000
+const GATE_MAX_FINDINGS = 5
+const GATE_MAX_SESSIONS = 64
+const GATE_PROVIDER = process.env.OCR_GATE_PROVIDER ?? "deepseek"
+const GATE_MODEL = process.env.OCR_GATE_MODEL ?? "deepseek-flash"
+const GATE_SENSITIVE_PATH =
+  /(?:^|\/)(?:auth|authn|authz|login|session|token|secret|crypto|password|payment|admin|sql|query|upload|deserialize|eval|permission|oauth|jwt|keys?)(?:[._/-]|$)/i
+
+const GATE_TOOLS = new Set(["edit", "write", "patch", "apply_patch", "multiedit", "multi_edit"])
+
+const CODE_EXT =
+  /\.(?:ts|tsx|js|jsx|mjs|cjs|py|go|java|kt|kts|rs|c|h|cc|cpp|cxx|hpp|cs|rb|php|swift|scala|sh|bash|zsh|sql|vue|svelte|astro|html|htm|css|scss|sass|less|yml|yaml|toml|json|jsonc|xml|gradle|proto|tf|tfvars)$/i
+
+const CODE_NAMES =
+  /(?:^|\/)(?:Dockerfile|Containerfile|Makefile|Procfile|Gemfile|Rakefile|\.env(?:\..*)?|[^/]+\.(?:pem|key|p12|pfx))$/i
+
+interface GateFinding {
+  fingerprint: string
+  severity: string
+  category: string
+  path: string
+  startLine: number
+  endLine: number
+  content: string
+}
+
+interface GateState {
+  repo?: string
+  timer: ReturnType<typeof setTimeout> | undefined
+  running: boolean
+  dirty: boolean
+  runs: number
+  tokens: number
+  errors: number
+  emptyRuns: number
+  lastRunAt: number
+  lastDiffHash: string
+  injected: Set<string>
+  pending: { text: string; at: number } | undefined
+  injections: number
+  injectedAt: number
+  stopped: boolean
+}
+
+const gateStates = new Map<string, GateState>()
+
+function gateState(sessionID: string): GateState {
+  let state = gateStates.get(sessionID)
+  if (state) return state
+  state = {
+    timer: undefined,
+    running: false,
+    dirty: false,
+    runs: 0,
+    tokens: 0,
+    errors: 0,
+    emptyRuns: 0,
+    lastRunAt: 0,
+    lastDiffHash: "",
+    injected: new Set<string>(),
+    pending: undefined,
+    injections: 0,
+    injectedAt: 0,
+    stopped: false,
+  }
+  gateStates.set(sessionID, state)
+  if (gateStates.size > GATE_MAX_SESSIONS) {
+    const oldest = gateStates.keys().next().value
+    if (oldest !== undefined) gateStates.delete(oldest)
+  }
+  return state
+}
+
+function gateAgent(agent: string): boolean {
+  return agent === "" || agent === "goal" || agent === "auto"
+}
+
+function collectPaths(input: unknown): string[] {
+  const paths: string[] = []
+  const visit = (value: unknown, key?: string): void => {
+    if (typeof value === "string") {
+      if (key !== undefined && /^(?:filePath|file_path|path|file|filename|target)$/i.test(key)) {
+        paths.push(value)
+      }
+      for (const match of value.matchAll(/^\+\+\+ b\/(.+)$/gm)) {
+        if (match[1] !== undefined) paths.push(match[1])
+      }
+      for (const match of value.matchAll(/^\*\*\* (?:Update|Add|Delete) File: (.+)$/gm)) {
+        if (match[1] !== undefined) paths.push(match[1])
+      }
+      return
+    }
+    if (Array.isArray(value)) {
+      for (const item of value) visit(item)
+      return
+    }
+    if (value !== null && typeof value === "object") {
+      for (const [childKey, childValue] of Object.entries(value)) visit(childValue, childKey)
+    }
+  }
+  visit(input)
+  return [...new Set(paths)]
+}
+
+function isCodePathList(paths: string[]): boolean {
+  return paths.some((candidate) => CODE_EXT.test(candidate) || CODE_NAMES.test(candidate))
+}
+
+function findRepo(paths: string[], fallback: string): string | undefined {
+  for (const candidate of [...paths, fallback]) {
+    let current = resolve(candidate)
+    if (!existsSync(current)) current = dirname(current)
+    for (let depth = 0; depth < 24; depth += 1) {
+      if (existsSync(join(current, ".git"))) return current
+      const parent = dirname(current)
+      if (parent === current) break
+      current = parent
+    }
+  }
+  return undefined
+}
+
+const execFileAsync = promisify(execFile)
+
+async function gitText(repo: string, args: string[]): Promise<string> {
+  const { stdout } = await execFileAsync("git", args, {
+    cwd: repo,
+    timeout: 5_000,
+    maxBuffer: 4 * 1024 * 1024,
+  })
+  return stdout
+}
+
+async function diffHash(repo: string): Promise<string | null> {
+  try {
+    const inside = (await gitText(repo, ["rev-parse", "--is-inside-work-tree"])).trim()
+    if (inside !== "true") return null
+    const [diff, status] = await Promise.all([
+      gitText(repo, ["diff", "--no-ext-diff", "--no-color", "HEAD"]),
+      gitText(repo, ["status", "--porcelain"]),
+    ])
+    const text = `${diff}\n--status--\n${status}`
+    if (!text.trim()) return null
+    return createHash("sha256").update(text).digest("hex")
+  } catch {
+    return null
+  }
+}
+
+async function diffProfile(repo: string): Promise<{ changed: number; sensitive: boolean } | null> {
+  try {
+    const [numstat, names, status] = await Promise.all([
+      gitText(repo, ["diff", "--numstat", "HEAD"]),
+      gitText(repo, ["diff", "--name-only", "HEAD"]),
+      gitText(repo, ["status", "--porcelain"]),
+    ])
+    let changed = 0
+    for (const line of numstat.split("\n")) {
+      const [added, removed] = line.split("\t")
+      const add = Number(added)
+      const del = Number(removed)
+      if (Number.isFinite(add)) changed += add
+      if (Number.isFinite(del)) changed += del
+    }
+    const statusPaths = status
+      .split("\n")
+      .map((line) => line.slice(3).trim())
+      .map((path) => (path.includes(" -> ") ? path.split(" -> ").pop() ?? path : path))
+      .filter(Boolean)
+    const paths = [...names.split("\n"), ...statusPaths]
+    return { changed, sensitive: paths.some((path) => GATE_SENSITIVE_PATH.test(path)) }
+  } catch {
+    return null
+  }
+}
+
+function gateFindings(payload: any): GateFinding[] {
+  const comments = Array.isArray(payload?.comments) ? payload.comments : []
+  const findings: GateFinding[] = []
+  for (const comment of comments) {
+    const category = String(comment?.category ?? "")
+    const severity = String(comment?.severity ?? "")
+    if (category !== "security" && category !== "bug") continue
+    if (severity !== "critical" && severity !== "high") continue
+    const path = String(comment?.path ?? "")
+    const content = String(comment?.content ?? "").trim()
+    if (!path || !content) continue
+    const startLine = Number(comment?.start_line ?? 0)
+    const endLine = Number(comment?.end_line ?? startLine)
+    const fingerprint = createHash("sha256")
+      .update(`${path}:${startLine}:${category}:${severity}:${content.slice(0, 160)}`)
+      .digest("hex")
+      .slice(0, 16)
+    findings.push({ fingerprint, severity, category, path, startLine, endLine, content })
+    if (findings.length >= GATE_MAX_FINDINGS) break
+  }
+  return findings
+}
+
+function formatGateText(
+  findings: GateFinding[],
+  meta: { run: number; tokens: number; effort: string; session?: string },
+): string {
+  const trace = meta.session ? ` session ${meta.session.slice(0, 8)}.` : ""
+  const head = `[security-gate] OCR ${meta.effort} found ${findings.length} new blocking finding(s) in the current workspace diff (run ${meta.run}/${GATE_MAX_RUNS}, ~${Math.round(meta.tokens / 1000)}k tokens).${trace}`
+  const lines = findings.map((finding) => {
+    const content = finding.content.replace(/\s+/g, " ").slice(0, 180)
+    return `- ${finding.severity} ${finding.path}:${finding.startLine} [${finding.category}] ${content}`
+  })
+  return [
+    head,
+    ...lines,
+    `Before reporting done: fix, or add a source→sink line / one repro; otherwise mark unverified (max 3). Do not claim "no vulnerabilities".`,
+  ].join("\n")
+}
+
+function scheduleGate(sessionID: string, ctx: any, repo?: string): void {
+  const state = gateState(sessionID)
+  if (state.stopped) return
+  if (repo !== undefined) state.repo = repo
+  state.dirty = true
+  if (state.timer !== undefined) clearTimeout(state.timer)
+  state.timer = setTimeout(() => {
+    state.timer = undefined
+    void runGate(sessionID, ctx)
+  }, GATE_DEBOUNCE_MS)
+  state.timer.unref?.()
+}
+
+async function runGate(sessionID: string, ctx: any): Promise<void> {
+  const state = gateState(sessionID)
+  if (state.running || state.stopped) return
+  if (state.runs >= GATE_MAX_RUNS || state.tokens >= GATE_MAX_TOTAL_TOKENS) {
+    state.stopped = true
+    return
+  }
+  const now = Date.now()
+  if (now - state.lastRunAt < GATE_MIN_INTERVAL_MS) {
+    if (state.timer === undefined) {
+      const wait = GATE_MIN_INTERVAL_MS - (now - state.lastRunAt)
+      state.timer = setTimeout(() => {
+        state.timer = undefined
+        void runGate(sessionID, ctx)
+      }, wait)
+      state.timer.unref?.()
+    }
+    return
+  }
+  const repo = state.repo ?? findRepo([], String(ctx?.location?.directory ?? process.cwd()))
+  if (repo === undefined) return
+  const hash = await diffHash(repo)
+  if (hash === null || hash === state.lastDiffHash) {
+    state.dirty = false
+    return
+  }
+  const profile = await diffProfile(repo)
+  const effort = profile?.sensitive || (profile?.changed ?? 0) > 200 ? "medium" : "low"
+  state.running = true
+  state.dirty = false
+  try {
+    const result = await runOcr(
+      buildReviewArgs(
+        {
+          effort,
+          maxTokensBudget: GATE_MAX_TOKENS_PER_RUN,
+          provider: GATE_PROVIDER,
+          model: GATE_MODEL,
+          timeoutMinutes: 2,
+          concurrency: 4,
+          background:
+            "Automatic security gate after code edits. Report only security or bug findings at critical/high severity; ignore style, docs, and maintainability.",
+        },
+        repo,
+      ),
+      { cwd: repo, timeoutMs: GATE_TIMEOUT_MS, maxOutputBytes: 4 * 1024 * 1024 },
+    )
+    const payload = JSON.parse(result.stdout)
+    const findings = gateFindings(payload)
+    const tokens = Number(payload?.summary?.total_tokens ?? 0)
+    state.tokens += Number.isFinite(tokens) ? tokens : 0
+    state.lastDiffHash = hash
+    state.lastRunAt = Date.now()
+    state.runs += 1
+    state.errors = 0
+    const fresh = findings.filter((finding) => !state.injected.has(finding.fingerprint))
+    if (fresh.length === 0) {
+      state.emptyRuns += 1
+      if (state.emptyRuns >= 2) state.stopped = true
+    } else {
+      state.emptyRuns = 0
+      for (const finding of fresh) state.injected.add(finding.fingerprint)
+      state.pending = {
+        text: formatGateText(fresh, {
+          run: state.runs,
+          tokens: state.tokens,
+          effort,
+          session: String(payload?.session_id ?? payload?.sessionId ?? ""),
+        }),
+        at: Date.now(),
+      }
+      if (state.injections >= GATE_MAX_INJECTIONS) state.stopped = true
+    }
+  } catch {
+    state.errors += 1
+    if (state.errors >= 2) state.stopped = true
+  } finally {
+    state.running = false
+    if (state.stopped || state.runs >= GATE_MAX_RUNS || state.tokens >= GATE_MAX_TOTAL_TOKENS) {
+      state.stopped = true
+      return
+    }
+    if (state.dirty) scheduleGate(sessionID, ctx, state.repo)
+  }
+}
+
+async function installSecurityGate(ctx: any): Promise<void> {
+  if (!GATE_ENABLED) return
+
+  await ctx.tool.hook("execute.after", async (event: any) => {
+    const sessionID = String(event?.sessionID ?? "")
+    if (!sessionID) return
+    if (String(event?.status ?? "") !== "completed") return
+    const tool = String(event?.tool ?? "")
+    if (tool === "ocr_review") {
+      // A manual review already paid for this diff: remember its fingerprints so
+      // the automatic gate does not immediately review the same thing again.
+      const state = gateState(sessionID)
+      const content = event?.result?.content
+      if (typeof content === "string") {
+        try {
+          const payload = JSON.parse(content)
+          for (const finding of gateFindings(payload)) state.injected.add(finding.fingerprint)
+          const repo =
+            state.repo ?? findRepo(collectPaths(event?.input), String(ctx?.location?.directory ?? process.cwd()))
+          if (repo !== undefined) {
+            state.repo = repo
+            const hash = await diffHash(repo)
+            if (hash !== null) state.lastDiffHash = hash
+          }
+        } catch {
+          // Preview/non-JSON output: nothing to dedupe.
+        }
+      }
+      return
+    }
+    if (!GATE_TOOLS.has(tool)) return
+    const agent = String(event?.agent ?? "")
+    if (!gateAgent(agent)) return
+    const paths = collectPaths(event?.input)
+    if (!isCodePathList(paths)) return
+    const repo = findRepo(paths, String(ctx?.location?.directory ?? process.cwd()))
+    if (repo === undefined) return
+    scheduleGate(sessionID, ctx, repo)
+  })
+
+  await ctx.session.hook("context", (event: any) => {
+    try {
+      if (!gateAgent(String(event?.agent ?? ""))) return
+      const state = gateStates.get(String(event?.sessionID ?? ""))
+      if (state?.pending === undefined) return
+      if (state.injections >= GATE_MAX_INJECTIONS) {
+        state.pending = undefined
+        return
+      }
+      if (Date.now() - state.injectedAt < GATE_INJECTION_COOLDOWN_MS) return
+      event.system.push({ type: "text", text: state.pending.text })
+      state.injections += 1
+      state.injectedAt = Date.now()
+      if (state.injections >= GATE_MAX_INJECTIONS) state.pending = undefined
+    } catch {
+      // A nudge must never break the request it rides on.
+    }
   })
 }
 
