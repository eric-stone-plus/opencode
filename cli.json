{
  "$schema": "https://opencode.ai/v2/cli.json",
  "mouse": true,
  "keybinds": {
    "app.exit": "none",
    "agent.cycle": "tab",
    "agent.cycle.reverse": "shift+tab",
    "session.page.up": "pageup,ctrl+up,alt+up,ctrl+alt+b",
    "session.page.down": "pagedown,ctrl+down,alt+down,ctrl+alt+f",
    "session.line.up": "ctrl+alt+y,ctrl+shift+up",
    "session.line.down": "ctrl+alt+e,ctrl+shift+down"
  },
  "session": {
    "thinking": "show",
    "verbosity": "medium",
    "grouping": "auto",
    "scrollbar": false,
    "new_location": "launch",
    "sidebar": "auto",
    "tps": true,
    "image_preview": false,
    "markdown": "rendered"
  },
  "diffs": {
    "view": "auto",
    "wrap": "word",
    "single": false
  },
  "attention": {
    "volume": 0
  },
  "animations": true,
  "theme": {
    "mode": "system"
  },
  "scroll": {
    "acceleration": true
  },
  "prompt": {
    "paste": "compact",
    "image_preview": false
  },
  "terminal": {
    "copy": "select"
  }
}
