[
  { "label": "pkill -f node server.js", "cmd": "pkill -f node server.js", "expect": "block" },
  { "label": "pkill --full", "cmd": "pkill --full myapp", "expect": "block" },
  { "label": "pkill -if (bundled)", "cmd": "pkill -if myapp", "expect": "block" },
  { "label": "pkill -9f (bundled)", "cmd": "pkill -9f myapp", "expect": "block" },
  { "label": "bracket trick still blocked", "cmd": "pkill -f '[n]ode'", "expect": "block" },
  { "label": "flag before -f: -9", "cmd": "pkill -9 -f vite", "expect": "block" },
  { "label": "flag before -f: --signal", "cmd": "pkill --signal TERM -f vite", "expect": "block" },
  { "label": "pgrep -f | xargs kill", "cmd": "pgrep -f myapp | xargs kill", "expect": "block" },
  { "label": "pgrep flag before -f | kill", "cmd": "pgrep -u root -f myapp | xargs kill", "expect": "block" },
  { "label": "kill $(pgrep -f)", "cmd": "kill $(pgrep -f myapp)", "expect": "block" },
  { "label": "killall -r", "cmd": "killall -r myapp", "expect": "block" },
  { "label": "killall -9 -r", "cmd": "killall -9 -r myapp", "expect": "block" },
  { "label": "ps|grep literal|xargs kill", "cmd": "ps aux | grep myapp | awk '{print $2}' | xargs kill", "expect": "block" },
  { "label": "sudo pkill -f", "cmd": "sudo pkill -f node", "expect": "block" },
  { "label": "nested bash -c", "cmd": "bash -c \"pkill -f x\"", "expect": "block" },
  { "label": "multi-statement", "cmd": "pkill -f x ; echo REACHED", "expect": "block" },
  { "label": "ssh remote pkill", "cmd": "ssh host 'pkill -f x'", "expect": "block" },
  { "label": "command substitution voids echo exemption", "cmd": "echo \"$(pkill -f x)\"", "expect": "block" },
  { "label": "pkill -x (comm match)", "cmd": "pkill -x node", "expect": "allow" },
  { "label": "pkill without -f", "cmd": "pkill node", "expect": "allow" },
  { "label": "numeric kill", "cmd": "kill -TERM 12345", "expect": "allow" },
  { "label": "kill by port", "cmd": "lsof -ti:3000 | xargs -r kill", "expect": "allow" },
  { "label": "fuser by port", "cmd": "fuser -k 8000/tcp", "expect": "allow" },
  { "label": "pattern from file (AGENTS.md method 3)", "cmd": "ps -eo pid=,args= | grep -F -f /tmp/kill.pat | awk '{print $1}' | xargs -r kill", "expect": "allow" },
  { "label": "pattern as data", "cmd": "grep -rn \"pkill -f\" ~/.config", "expect": "allow" },
  { "label": "write pattern file", "cmd": "printf '%s\\n' 'myapp' > /tmp/kill.pat", "expect": "allow" },
  { "label": "pgrep inspect", "cmd": "pgrep -af node", "expect": "allow" },
  { "label": "pgrep -f read-only", "cmd": "pgrep -f myapp", "expect": "allow" },
  { "label": "ps|grep no kill", "cmd": "ps aux | grep myapp", "expect": "allow" },
  { "label": "killall by name", "cmd": "killall node", "expect": "allow" },
  { "label": "echo benign", "cmd": "echo hello world", "expect": "allow" },
  { "label": "echo pattern as data", "cmd": "echo \"pkill -f is dangerous\"", "expect": "allow" },
  { "label": "echo pattern to file", "cmd": "echo pkill -f x > /tmp/notes.txt", "expect": "allow" },
  { "label": "git log | grep", "cmd": "git log --oneline | grep pkill", "expect": "allow" },
  { "label": "filename containing pkill", "cmd": "vim /tmp/pkill-notes.txt", "expect": "allow" },
  { "label": "service name containing pkill", "cmd": "systemctl kill pkilld.service", "expect": "allow" },
  { "label": "malformed JSON", "cmd": "this is not json", "expect": "allow", "raw": true },
  { "label": "empty stdin", "cmd": "", "expect": "allow", "raw": true },
  { "label": "quoted flag", "cmd": "pkill \"-f\" vite", "expect": "allow", "note": "known limitation: pattern matcher, not a shell parser" },
  { "label": "--full with bogus arg", "cmd": "pkill --full=v vite", "expect": "allow", "note": "pkill --full takes no argument; invocation invalid anyway" }
]
