# ~/.config/opencode/env — auth.json re-seed SEED FILE only.
# NOT read by the opencode binary and NOT sourced by the shell wrapper.
# install.sh copies this to ~/.config/opencode/env when absent; fill it with the
# real values on machine B so auth.json can be re-seeded after a wipe.
# Machine-A reference values (non-secret part documented in README):
#   OPENCODE_EXPERIMENTAL_OUTPUT_TOKEN_MAX=65536 (five-digit numeric cap)
# Variable NAMES must match machine A exactly:
export QIANWEN_TP_PERSONAL_KEY=
export OPENCODE_EXPERIMENTAL_OUTPUT_TOKEN_MAX=
