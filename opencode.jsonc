{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "lsp": {
    // basedpyright runs in the built-in "pyright" slot: keeps nearest-pyproject roots (nested .venv) and avoids a duplicate second Python server.
    "pyright": {
      "command": ["basedpyright-langserver", "--stdio"],
      // "standard" keeps feedback to real type errors; the default "recommended" floods error-level style findings.
      "initialization": { "basedpyright": { "analysis": { "typeCheckingMode": "standard" } } }
    }
  },
  // Default track (2026-10-07): DeepSeek-V4.1-Flash, and since 2026-10-15
  // DeepSeek is the only provider in this config (ADR 0009/0010): the
  // alibaba/mimo provider blocks and their credentials were removed, so
  // there is no other track to revert to. API id is deepseek-flash
  // (deepseek-v4-flash is a retired alias that now routes to the same
  // model).
  "model": "deepseek/deepseek-flash",
  "provider": {
    // DeepSeek official API. npm + baseURL are the registry values, so
    // this block only overlays the flash model. Key is already in
    // auth.json under provider id "deepseek".
    //
    // deepseek-flash is DeepSeek-V4.1-Flash (1M context, 384K max output,
    // text+image). Effort on the wire is reasoning_effort low|high|max;
    // max is the top (medium and xhigh are aliases, not higher tiers).
    // Thinking is on by default. temperature is ignored while thinking;
    // top_p below 0.95 is raised to 0.95. Published agent evals use
    // top_p 0.95. Reasoning tokens count against max_tokens when the cap
    // is enforced (probed 2026-10-07: effort max with max_tokens 16
    // finished "length" and returned an empty answer). Enforcement is
    // not universal: probed 2026-10-08, a main-agent request carrying
    // the `task` tool ignored max_tokens 64 (2231 completion tokens,
    // "stop"); removing only `task` from the toolset made the same
    // request enforce the cap (64, "length"). Do not rely on
    // max_tokens to bound a main-agent turn.
    //
    // limit.input is load-bearing (overflow.ts): with it the compaction
    // watermark is the 256k working cap minus 20k. Without it the full
    // output budget is deducted. 606784 = 1000000 - 393216.
    //
    // options.maxOutputTokens is the FULL 384K (393216) on purpose:
    // probed on the wire 2026-10-07, without it the request carries
    // max_tokens 32000 (transform.ts OUTPUT_TOKEN_MAX fallback) and with
    // it the request carries max_tokens 393216. The larger cap costs
    // nothing unless the model uses it, and reasoning tokens count
    // against max_tokens. If a shell ever exports
    // OPENCODE_EXPERIMENTAL_OUTPUT_TOKEN_MAX, that flag overrides this
    // value (probed: env 65536 -> max_tokens 65536 even with
    // maxOutputTokens 393216). ~/.config/opencode/env holds such an
    // export but nothing sources it (not the opencode wrapper, not
    // bashrc, not opencode itself), so it is inert unless sourced.
    "deepseek": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "DeepSeek",
      "options": {
        "baseURL": "https://api.deepseek.com",
        // DeepSeek queues instead of rejecting when an account hits its
        // concurrency ceiling, and closes a request that has not started
        // inference after 10 minutes. The 300 s default header timeout gives
        // up before the provider does, so match the provider's own window
        // (decided 2026-10-15 with the swarm fan-out change).
        "headerTimeout": 600000
      },
      "models": {
        "deepseek-flash": {
          "tool_call": true,
          "limit": {
            "context": 1000000,
            "input": 606784,
            "output": 393216
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "options": {
            "reasoningEffort": "max",
            "top_p": 0.95,
            "maxOutputTokens": 393216
          }
        }
      }
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    // Explicit value bypasses the 2k-15k clamp at compaction.ts:117 and
    // takes effect directly, keeping a longer verbatim tail in long sessions.
    "preserve_recent_tokens": 40000
  },
  "permission": "allow",
  // Swarm default (owner call 2026-10-15): primaries fan out subagents, and a
  // subagent may fan out again. Upstream's default of 1 forbids nesting
  // outright; 100 is "no limit" in practice - the schema has no maximum and no
  // real tree reaches 100 levels. Fan-out width was never capped (measured:
  // 500 concurrent sessions on one server, zero errors, ~1.1 GB RSS).
  "experimental": {
    "subagent_depth": 100
  },
  "default_agent": "auto",
  "agent": {
    // Two profiles (owner call 2026-10-14): auto (blue) and goal (red).
    // Explicit colors: without them the TUI picks positionally from
    // [secondary, accent, success, warning, primary, error, info].
    "auto": {
      "description": "Auto mode. Fast, light problem-solving: execute directly, verify with the work's own checks, report terse. Never asks, never blocks.",
      "mode": "primary",
      "color": "#5c9cf5",
      // Variant applies via the same-model gate (agent model must equal
      // the resolved model). deepseek-flash's effort set is
      // {low, high, max}; "max" is the top and is sent as
      // reasoning_effort. Model options.reasoningEffort is the same
      // value, so a turn that does not carry the variant still asks
      // for max.
      "model": "deepseek/deepseek-flash",
      "variant": "max",
      // findLast() keeps the LAST matching rule, so the wildcard must come
      // first and the narrow denials after it, or they get overridden.
      // The seat is the agent's own brain (AGENTS.md "no self-evolution"):
      // the edit/write tools refuse it, both resource forms, because
      // file-access.ts:102 hands tools a location-relative path for targets
      // inside the session's location and an absolute one for targets
      // outside. The shell stays open for the operator's install path.
      "permission": {
        "*": "allow",
        "question": "deny",
        "edit": {
          "~/.config/opencode/*": "deny",
          ".config/opencode/*": "deny"
        }
      }
    },
    // Goal mode: red Goal profile. The prompt body lives in agent/goal.md
    // (markdown wins the merge per key; item.prompt = value.prompt ??
    // item.prompt keeps it); this block pins the surface so both profiles
    // declare it in one place. Same no-interrupt surface as auto: the swarm
    // playbook must never be blocked by a prompt mid-run.
    "goal": {
      "description": "Goal mode. Every message steers one session goal to a flawless delivery closure (adversarial swarm playbook + closure checklist); discussion and report in Chinese.",
      "mode": "primary",
      "color": "#e06c75",
      "model": "deepseek/deepseek-flash",
      "variant": "max",
      // Same seat deny as auto: the card declares it too, so the rule lands
      // last whichever document is applied last (see the auto block).
      "permission": {
        "*": "allow",
        "question": "deny",
        "edit": {
          "~/.config/opencode/*": "deny",
          ".config/opencode/*": "deny"
        }
      }
    },
    // build and plan are removed, not hidden. `disable` is the legacy `agent`
    // block's spelling (V1 ConfigAgentV1.Info); `disabled` is NOT a V1 field —
    // normalize would push it into request.body and leave the agent alive
    // (packages/core/src/v1/config/agent.ts + v1/config/migrate.ts).
    "build": { "disable": true },
    "plan": { "disable": true },
    // Subagents keep their own ruleset and never inherit the parent agent's,
    // so they need the question tool denied too or they can block mid-task.
    // `task` is deliberately NOT denied (owner call 2026-10-15): a subagent
    // may fan out its own swarm, bounded by experimental.subagent_depth. The
    // todowrite deny is likewise re-asserted after the global wildcard.
    "general": {
      "permission": { "question": "deny", "todowrite": "deny" }
    },
    // The global "permission": "allow" merges after explore's native
    // "*": "deny" and findLast() keeps the allow, so explore could edit files
    // (probed 2026-10-08: `explore edit /etc/passwd -> allow`). Re-assert the
    // native read-only surface so exploration cannot route edits.
    "explore": {
      "permission": {
        "edit": "deny",
        "task": "deny",
        "todowrite": "deny",
        "question": "deny"
      }
    }
  }
}
