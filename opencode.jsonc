{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  // Default track (2026-10-07): temporary switch to DeepSeek-V4.1-Flash.
  // API id is deepseek-flash (deepseek-v4-flash is a retired alias that
  // now routes to the same model). Revert this line and the auto/goal
  // pins to "xiaomi-token-plan-cn/mimo-v2.6-pro" to go back. Other
  // provider blocks are unchanged.
  "model": "deepseek/deepseek-flash",
  // Cost display (2026-10-10): flat-rate/subscription model rows (all-zero
  // cost in the registry) are auto-matched to canonical PAYG list prices so
  // /usage can show a labeled estimate ("not billed per token"). DeepSeek is
  // true PAYG (declared rates). To pin literal $0 on a model block, declare
  // `cost: { "input": 0, "output": 0 }` — config-declared costs win outright
  // over the registry cascade.
  "provider": {
    "bailian-token-plan-personal": {
      "npm": "@ai-sdk/anthropic",
      "name": "Alibaba Cloud Model Studio",
      "options": {
        "baseURL": "https://token-plan.cn-beijing.maas.aliyuncs.com/apps/anthropic/v1"
      },
      "models": {
        "qwen3.8-max": {
          "name": "Qwen3.8 Max",
          "reasoning": true,
          "limit": {
            "context": 983616,
            "input": 852544,
            "output": 131072
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "options": {
            "effort": "max",
            "maxOutputTokens": 65536,
            // Per-model compaction adaptation (2026-10-10): raise the
            // conservative 256k WORKING_CONTEXT_CAP clamp (overflow.ts) to the
            // hand-calibrated limit.input of this block. Same pattern pinned on
            // the zhipuai/mimo/deepseek blocks.
            "workingContextCap": 852544
          }
        }
      }
    },
    // GLM-5.3 via Zhipu Coding Plan, Anthropic-compatible surface (tested
    // 2026-09-27: tools/streaming/parallel tool_use/cache_control all pass;
    // baseURL MUST keep the /v1 suffix — @ai-sdk/anthropic only appends
    // /messages, and the no-suffix path returns HTTP 200 wrapping a 404).
    // Key lives in auth.json under the same provider id; direct connection
    // only (open.bigmodel.cn is in the no_proxy lists).
    // 2026-09-28: NOT the default anymore — billing surface does not match
    // the mainland token plan. Manual fallback only; tuned limits moved to
    // the zhipuai-coding-plan block below.
    "glm-coding-plan": {
      "npm": "@ai-sdk/anthropic",
      "name": "GLM Coding Plan",
      "options": {
        "baseURL": "https://open.bigmodel.cn/api/anthropic/v1"
      },
      "models": {
        "glm-5.3": {
          "name": "GLM-5.3",
          "reasoning": true,
          "limit": {
            "context": 1000000,
            "output": 131072
          },
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          },
          "options": {
            // Raised with the coding-plan block 2026-09-29; same
            // model/plan, anthropic face itself untested (extrapolated).
            "maxOutputTokens": 131072
          }
        },
        "glm-5.3-flash": {
          "name": "GLM-5.3 Flash",
          "reasoning": true,
          "limit": {
            "context": 1000000,
            "output": 131072
          },
          "modalities": {
            "input": ["text", "image", "video"],
            "output": ["text"]
          },
          "options": {
            "maxOutputTokens": 131072
          }
        }
      }
    },
    // Mainland token-plan track: merges onto the binary's built-in
    // zhipuai-coding-plan models.dev entry (npm/baseURL duplicated verbatim
    // so nothing overrides the registry). Carries the tuned limits migrated
    // from the glm block on 2026-09-28.
    "zhipuai-coding-plan": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Zhipu AI Coding Plan",
      "options": {
        "baseURL": "https://open.bigmodel.cn/api/coding/paas/v4"
      },
      "models": {
        "glm-5.3": {
          "name": "GLM-5.3",
          "reasoning": true,
          "limit": {
            "context": 1000000,
            // overflow.ts:29 — without limit.input it deducts the full
            // maxOutputTokens (131072 since 2026-09-29) leaving 124928;
            // with it the min(20000,...) keep branch yields 236000 per
            // compaction cycle.
            "input": 868928,
            "output": 131072
          },
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          },
          "options": {
            // 2026-09-29 swarm (R2-C): zhipu coding-plan counts
            // reasoning_tokens against max_tokens exactly like xiaomi
            // (8192-budget run: 7818 reasoning + 374 text = 8192,
            // finish=length); 131072 accepted for glm-5.3 AND flash
            // (262144 → 400 "限制数值范围[1,131072]").
            "maxOutputTokens": 131072,
            "workingContextCap": 868928
          }
        },
        "glm-5.3-flash": {
          "name": "GLM-5.3 Flash",
          "reasoning": true,
          "limit": {
            "context": 1000000,
            // Same as glm-5.3. The old 236k compaction watermark is
            // superseded by the workingContextCap pin below (2026-10-10).
            "input": 868928,
            "output": 131072
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "options": {
            // Raised with glm-5.3 2026-09-29 (flash validated to 131072).
            "maxOutputTokens": 131072,
            "workingContextCap": 868928
          }
        }
      }
    },
    // Xiaomi MiMo token-plan track (mainland CN). Endpoint choice
    // (probed 2026-09-29): BOTH faces work — /v1 (OpenAI) and
    // /anthropic/v1 (Messages). Picked /v1 because it matches the
    // models.dev registry entry verbatim (npm/baseURL duplicated here so
    // nothing overrides it), keeps GET /v1/models alive for discovery,
    // and the reasoning_content → thinking mapping is already declared in
    // the registry (interleaved.field). Measured parity on the deciding
    // axes: implicit prefix caching reports on both faces
    // (cached_tokens/cache_read_input_tokens ≈ 2944/3020 on a repeat
    // call), streaming thinking deltas on both, multi-turn thinking
    // replay with empty signatures accepted on the anthropic face.
    // The /anthropic face would only add native thinking blocks at the
    // cost of overriding npm + losing /v1/models — no long-session win.
    //
    // Long-task tuning:
    // - limit.input is load-bearing (overflow.ts:29): with it the usable
    //   window is the workingContextCap pin below minus the 20k reserve
    //   (917504 − 20k = 897504 per compaction cycle; the pre-2026-10-10
    //   256k clamp yielded 236k). Without it the full maxOutputTokens is
    //   deducted and the cycle lands at 190464. 917504 = context − output.
    // - maxOutputTokens is the FULL 131072 on purpose (glm blocks raised
    //   to match 2026-09-29 — same shared-budget semantics measured on
    //   the zhipu endpoint; bailian left at 65536, endpoint untested):
    //   reasoning_tokens count against max_tokens (complex prompt at
    //   max_tokens=2000 → completion 2000, of which 1036 reasoning,
    //   finish=length, visible answer truncated). A 65536 cap lets the
    //   reasoning budget eat half the turn and cut the actual work off
    //   mid-tool-call. Token-plan billing is flat (cost 0 in registry),
    //   so the larger cap costs nothing unless the model uses it.
    // - effort/variants (swarm-verified 2026-09-29): computed variant
    //   set is {low, medium, high} — the registry's toggle-only
    //   reasoning_options collapses (reasoningToggle() {} →
    //   nonEmptyVariants → undefined) and the generic openai-compatible
    //   ladder at transform.ts:1000-1008 takes over. Pins ARE wire-live
    //   (reasoning_effort reaches the body, @ai-sdk/openai-compatible
    //   dist:538) but the gateway honors none-vs-on only: low/medium/high
    //   measured statistically identical (non-monotone);
    //   reasoning_effort:"none" kills thinking entirely (off-switch only
    //   via model options.reasoningEffort, not the variant ladder).
    //   Agents pin "high" = ladder top; mimo has no "max".
    "xiaomi-token-plan-cn": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Xiaomi MiMo Token Plan (CN)",
      "options": {
        "baseURL": "https://token-plan-cn.xiaomimimo.com/v1"
      },
      "models": {
        "mimo-v2.6-pro": {
          "name": "MiMo-V2.6-Pro",
          "reasoning": true,
          "limit": {
            "context": 1048576,
            "input": 917504,
            "output": 131072
          },
          "modalities": {
            "input": ["text", "image", "audio", "video"],
            "output": ["text"]
          },
          "options": {
            "maxOutputTokens": 131072,
            "workingContextCap": 917504
          }
        },
        "mimo-v2.6-flash": {
          "name": "MiMo-V2.6-Flash",
          "reasoning": true,
          "limit": {
            "context": 1048576,
            "input": 917504,
            "output": 131072
          },
          "modalities": {
            "input": ["text", "image", "audio", "video"],
            "output": ["text"]
          },
          "options": {
            "maxOutputTokens": 131072,
            "workingContextCap": 917504
          }
        }
      }
    },
    // DeepSeek official API. npm + baseURL are the registry values, so
    // this block only overlays the flash model. Key is already in
    // auth.json under provider id "deepseek".
    //
    // deepseek-flash is DeepSeek-V4.1-Flash (1M context, 384K max output,
    // text+image). Effort on the wire is reasoning_effort low|high|max;
    // max is the top (medium and xhigh are aliases, not higher tiers).
    // Thinking is on by default. temperature is ignored while thinking;
    // top_p below 0.95 is raised to 0.95. Published agent evals use
    // top_p 0.95. Reasoning tokens count against max_tokens when the cap
    // is enforced (probed 2026-10-07: effort max with max_tokens 16
    // finished "length" and returned an empty answer). Enforcement is
    // not universal: probed 2026-10-08, a main-agent request carrying
    // the `task` tool ignored max_tokens 64 (2231 completion tokens,
    // "stop"); removing only `task` from the toolset made the same
    // request enforce the cap (64, "length"). Do not rely on
    // max_tokens to bound a main-agent turn.
    //
    // limit.input is load-bearing (overflow.ts): with it the compaction
    // watermark is the 256k working cap minus 20k. Without it the full
    // output budget is deducted. 606784 = 1000000 - 393216.
    //
    // options.maxOutputTokens is the FULL 384K (393216) on purpose:
    // probed on the wire 2026-10-07, without it the request carries
    // max_tokens 32000 (transform.ts OUTPUT_TOKEN_MAX fallback) and with
    // it the request carries max_tokens 393216. The larger cap costs
    // nothing unless the model uses it, and reasoning tokens count
    // against max_tokens. If a shell ever exports
    // OPENCODE_EXPERIMENTAL_OUTPUT_TOKEN_MAX, that flag overrides this
    // value (probed: env 65536 -> max_tokens 65536 even with
    // maxOutputTokens 393216). ~/.config/opencode/env holds such an
    // export but nothing sources it (not the opencode wrapper, not
    // bashrc, not opencode itself), so it is inert unless sourced.
    "deepseek": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "DeepSeek",
      "options": {
        "baseURL": "https://api.deepseek.com"
      },
      "models": {
        "deepseek-flash": {
          "name": "DeepSeek-V4.1-Flash",
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 1000000,
            "input": 606784,
            "output": 393216
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "options": {
            "reasoningEffort": "max",
            "top_p": 0.95,
            "maxOutputTokens": 393216,
            "workingContextCap": 606784
          }
        }
      }
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    // Explicit value bypasses the 2k-15k clamp at compaction.ts:117 and
    // takes effect directly, keeping a longer verbatim tail in long sessions.
    "preserve_recent_tokens": 40000
  },
  "permission": "allow",
  "default_agent": "auto",
  "instructions": ["~/.config/opencode/autonomy.md", "~/.config/opencode/AGENTS.goal.md"],
  "agent": {
    "auto": {
      "description": "Autonomous mode. Never asks, never blocks: adopts the recommended option and runs to completion.",
      "mode": "primary",
      "color": "success",
      // Variant applies via the same-model gate (agent model must equal
      // the resolved model). deepseek-flash's effort set is
      // {low, high, max}; "max" is the top and is sent as
      // reasoning_effort. Model options.reasoningEffort is the same
      // value, so a turn that does not carry the variant still asks
      // for max.
      "model": "deepseek/deepseek-flash",
      "variant": "max",
      // findLast() keeps the LAST matching rule, so the wildcard must come
      // first and the narrow denials after it, or they get overridden.
      "permission": {
        "*": "allow",
        "question": "deny",
        "plan_enter": "deny",
        "plan_exit": "deny"
      }
    },
    // Goal mode: red Goal profile. The prompt body lives in agent/goal.md
    // (markdown wins the merge per key; item.prompt = value.prompt ??
    // item.prompt keeps it); this block pins the surface so all four
    // profiles declare it in one place. Same no-interrupt surface as auto:
    // the swarm playbook must never be blocked by a prompt mid-run.
    "goal": {
      "description": "Goal mode. Every message steers the session goal: run the adversarial subagent swarm playbook from AGENTS.md end to end.",
      "mode": "primary",
      "color": "error",
      "model": "deepseek/deepseek-flash",
      "variant": "max",
      "permission": {
        "*": "allow",
        "question": "deny",
        "plan_enter": "deny",
        "plan_exit": "deny"
      }
    },
    // Explicit colors: without them the TUI picks positionally from
    // [secondary, accent, success, warning, primary, error, info], so adding
    // `auto` would shift plan off orange. build keeps full allow except
    // plan_exit: build is never in plan mode, and plan_exit prompts via
    // Question.Service directly, bypassing the question gate.
    "build": {
      "color": "secondary",
      "permission": {
        "*": "allow",
        "question": "allow",
        "plan_enter": "allow",
        "plan_exit": "deny"
      }
    },
    // The global "permission": "allow" above merges AFTER plan's native
    // edit-deny and findLast() keeps the last match, so it silently defeats
    // plan mode's read-only guarantee. Re-asserting edit here merges last and
    // restores it, while still letting plan write its own plan documents.
    // Path forms: "home/eric/..." is the machine-A slash-less form (kept);
    // ".local/..." and "*/.local/..." make the allowlist user-agnostic across
    // homes, for both absolute and slash-less matcher inputs.
    "plan": {
      "color": "warning",
      "permission": {
        "*": "allow",
        "question": "allow",
        "plan_enter": "deny",
        "plan_exit": "allow",
        "edit": {
          "*": "deny",
          ".opencode/plans/*.md": "allow",
          "home/eric/.local/share/opencode/plans/*.md": "allow",
          ".local/share/opencode/plans/*.md": "allow",
          "*/.local/share/opencode/plans/*.md": "allow"
        },
        // Also defeated by the global wildcard: without this, plan mode can
        // route edits around its own read-only rule via the general subagent.
        "task": { "general": "deny" }
      }
    },
    // Subagents keep their own ruleset and never inherit the parent agent's,
    // so they need the question tool denied too or they can block mid-task.
    // plan_exit needs denying separately: it calls Question.Service directly
    // and never goes through ctx.ask, so `question: deny` does NOT gate it
    // (observed blocking 25s on an agent that already had question denied).
    // todowrite deny is likewise re-asserted after the global wildcard.
    "general": {
      "permission": { "question": "deny", "todowrite": "deny", "plan_exit": "deny" }
    },
    // Same global-wildcard defeat as plan: without this, the global
    // "permission": "allow" merges after explore's native "*": "deny" and
    // findLast() keeps the allow, so explore can edit files (probed
    // 2026-10-08: `explore edit /etc/passwd -> allow`). Re-assert the
    // native read-only surface so exploration cannot route edits.
    "explore": {
      "permission": {
        "edit": "deny",
        "task": "deny",
        "todowrite": "deny",
        "question": "deny",
        "plan_exit": "deny"
      }
    }
  }
}
