{
  "deepseek": {
    "id": "deepseek",
    "name": "DeepSeek",
    "env": [
      "DEEPSEEK_API_KEY"
    ],
    "npm": "@ai-sdk/openai-compatible",
    "api": "https://api.deepseek.com",
    "models": {
      "deepseek-reasoning": {
        "id": "deepseek-reasoning",
        "name": "DeepSeek Reasoning",
        "release_date": "2026-01-01",
        "attachment": false,
        "reasoning": true,
        "reasoning_options": [
          {
            "type": "effort",
            "values": [
              null,
              "null",
              "low",
              "high"
            ]
          },
          {
            "type": "budget_tokens",
            "min": 1024,
            "max": 64000
          },
          {
            "type": "toggle"
          }
        ],
        "temperature": true,
        "tool_call": true,
        "limit": {
          "context": 128000,
          "output": 8192
        },
        "experimental": {
          "modes": {
            "high": {
              "provider": {
                "headers": {
                  "x-mode": "high"
                },
                "body": {
                  "service_tier": "priority"
                }
              }
            },
            "pro": {
              "provider": {
                "body": {
                  "reasoning": {
                    "mode": "pro"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
